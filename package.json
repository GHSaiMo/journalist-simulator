{
  "name": "journalist-simulator",
  "version": "1.0.0",
  "description": "Raise the viewfinder to your eye, turn the aperture ring, and witness a fleeting afternoon at the turn of the millennium.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/build.mjs && node ./scripts/dev-server.mjs 1926",
    "start": "node ./scripts/dev-server.mjs 1926",
    "build": "node ./scripts/build.mjs",
    "build:textures": "python3 ./blender/scripts/generate_textures.py",
    "build:3d": "blender -b -P ./blender/scripts/build_scene.py"
  },
  "keywords": [
    "threejs",
    "webgl",
    "game",
    "photography",
    "photojournalism",
    "slr",
    "bokeh",
    "depth-of-field",
    "blender",
    "simulator"
  ],
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "rollup": "^4.68.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
